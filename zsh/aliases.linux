# Ubuntu ships bat as 'batcat' — this makes the shared 'cat=bat' alias chain work
command -v batcat &>/dev/null && alias bat='batcat'
alias open='xdg-open'

# Disable middle click (xinput device ID may vary per machine — override in ~/.zshrc.local)
alias xinput-list="xinput list | grep pointer"
alias xinput-middle-off="xinput set-button-map 13 1 1"

# Opens file as a temp copy in your normal VS Code; saves back as root when you close the tab
alias sudocode='SUDO_EDITOR="code --wait" sudoedit'

alias fkeys-on="echo 2 | sudo tee /sys/module/hid_apple/parameters/fnmode"
alias fkeys-off="echo 1 | sudo tee /sys/module/hid_apple/parameters/fnmode"
